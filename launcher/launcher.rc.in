// TMB Launcher's resources: its icon (TMB's variant of The Bozos' logo, launcher/tmb.ico; GLFW_ICON is the name GLFW gives the
// window's class, so the window and the taskbar show it too), the Exo 2 font and its licence, and version information.
#include <winver.h>

GLFW_ICON ICON "@LAUNCHER_ICON@"
EXO2 RCDATA "@LAUNCHER_EXO2@"
OFL RCDATA "@LAUNCHER_OFL@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @LAUNCHER_FILEVERSION@,0
PRODUCTVERSION @LAUNCHER_FILEVERSION@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The Bozos"
            VALUE "FileDescription", "TMB Launcher"
            VALUE "ProductName", "Twisted Metal: Black PC port (TMB_Recomp), by boubou666 & Arzaroth"
            VALUE "InternalName", "TMB Launcher"
            VALUE "OriginalFilename", "TMB Launcher.exe"
            VALUE "FileVersion", "@LAUNCHER_VERSION@"
            VALUE "ProductVersion", "@LAUNCHER_VERSION@ (@LAUNCHER_COMMIT@)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
