// The runner's resources on Windows: its icon (TMB's variant of The Bozos' logo, the clown with its head on fire; no game art; GLFW_ICON is the name GLFW gives the
// window's class, so the window and the taskbar show it too) and its version information.
#include <winver.h>

GLFW_ICON ICON "tmb.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Twisted Metal: Black"
            VALUE "ProductName", "Twisted Metal: Black (TMB_Recomp, a native PC port)"
            VALUE "InternalName", "tmb"
            VALUE "OriginalFilename", "tmb.exe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
